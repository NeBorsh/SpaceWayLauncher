<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SpaceWay.Launcher.ViewModels"
             xmlns:loc="using:SpaceWay.Launcher.Markup"
             xmlns:controls="using:SpaceWay.Launcher.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SpaceWay.Launcher.Views.FavoritesView"
             x:DataType="vm:FavoritesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="h1" Text="{loc:Translate nav-favorites}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="muted" Text="{Binding CountText}" />
                    <TextBlock Classes="muted"
                               IsVisible="{Binding Refresh.IsLoading}"
                               Text="{loc:Translate servers-loading}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{Binding Refresh.RefreshCommand}"
                    Content="{loc:Translate servers-refresh}" />
        </Grid>

        <Button Grid.Row="1"
                Classes="accent"
                HorizontalAlignment="Left"
                Margin="0,0,0,14"
                Command="{Binding AddServerCommand}"
                Content="{loc:Translate favorites-add}" />

        <controls:AngleCard Grid.Row="2"
                            IsVisible="{Binding Refresh.HasFailures}"
                            Classes="warning" Margin="0,0,0,10">
            <TextBlock Text="{Binding Refresh.FailuresText}"
                       FontSize="12"
                       Foreground="{StaticResource BrushWarning}" />
        </controls:AngleCard>

        <Panel Grid.Row="3">
            <StackPanel IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                <TextBlock Classes="h2"
                           HorizontalAlignment="Center"
                           Text="{loc:Translate favorites-empty}" />
                <TextBlock Classes="muted"
                           HorizontalAlignment="Center"
                           Text="{loc:Translate favorites-hint}" />
                <TextBlock Classes="muted"
                           HorizontalAlignment="Center"
                           Text="{loc:Translate favorites-hint-manual}" />
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Classes="cards"
                              ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource ServerCardTemplate}"
                              Margin="0,0,6,0">
                    <ItemsControl.Styles>
                        <Style Selector="ItemsControl.cards > ContentPresenter">
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ItemsControl.Styles>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
