<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SpaceWay.Launcher.ViewModels"
             xmlns:loc="using:SpaceWay.Launcher.Markup"
             mc:Ignorable="d" d:DesignWidth="420"
             x:Class="SpaceWay.Launcher.Views.ConfirmDialog"
             x:DataType="vm:ConfirmDialogViewModel">

    <StackPanel Spacing="14" Width="400">

        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="{Binding Text}" />

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
            <Button Command="{Binding DeclineCommand}"
                    Content="{loc:Translate confirm-decline}" />

            <Button Classes="danger"
                    Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmLabel}" />
        </StackPanel>
    </StackPanel>
</UserControl>
