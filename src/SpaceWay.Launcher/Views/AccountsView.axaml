<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SpaceWay.Launcher.ViewModels"
             xmlns:loc="using:SpaceWay.Launcher.Markup"
             xmlns:controls="using:SpaceWay.Launcher.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SpaceWay.Launcher.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Classes="h1"
                   Text="{loc:Translate nav-accounts}"
                   Margin="0,0,0,12" />

        <controls:AngleCard Grid.Row="1"
                IsVisible="{Binding ShowInsecureWarning}"
                Classes="warning" Margin="0,0,0,10">
            <TextBlock Text="{Binding InsecureWarningText}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushWarning}" />
        </controls:AngleCard>

        <Button Grid.Row="2"
                Classes="accent"
                HorizontalAlignment="Left"
                Margin="0,0,0,14"
                Command="{Binding AddAccountCommand}"
                Content="{loc:Translate accounts-new}" />

        <Panel Grid.Row="3">
            <TextBlock Classes="muted"
                       IsVisible="{Binding !HasAccounts}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{loc:Translate accounts-empty}" />

            <ListBox ItemsSource="{Binding Items}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,6,0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>

                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>

                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:AccountItemViewModel">
                        <controls:AngleCard Classes="card"
                                            Classes.selected="{Binding IsSelected}">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Classes="h2"
                                           Classes.selected="{Binding IsSelected}"
                                           Text="{Binding Username}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Row="0" Grid.Column="1"
                                        Classes="subtle"
                                        IsVisible="{Binding !IsSelected}"
                                        Command="{Binding SelectCommand}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Content="{loc:Translate accounts-select}" />

                                <Button Grid.Row="0" Grid.Column="2"
                                        Classes="subtle danger"
                                        Command="{Binding LogoutCommand}"
                                        VerticalAlignment="Center"
                                        Content="{loc:Translate accounts-logout}" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            Margin="0,6,0,0">
                                    <TextBlock Classes="muted" Text="{Binding AuthServerName}" />
                                    <TextBlock Classes="muted"
                                               Classes.expired="{Binding IsExpired}"
                                               Text="{Binding ExpiryText}" />
                                </StackPanel>
                            </Grid>
                        </controls:AngleCard>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0" Spacing="8">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,6,0">
                <TextBlock Grid.Column="0"
                           Classes="h2"
                           VerticalAlignment="Center"
                           Text="{loc:Translate accounts-servers}" />

                <Button Grid.Column="1"
                        Classes="subtle"
                        Command="{Binding AddServerCommand}"
                        Content="{loc:Translate auth-server-add}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Servers}" Padding="0,0,6,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:AuthServerItemViewModel">
                        <controls:AngleCard Classes="card" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Classes="h2"
                                           Text="{Binding DisplayName}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Row="0" Grid.Column="1"
                                        Classes="subtle danger"
                                        Command="{Binding RemoveCommand}"
                                        VerticalAlignment="Center"
                                        Content="{loc:Translate accounts-server-remove}" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            Margin="0,6,0,0">
                                    <TextBlock Classes="muted" Text="{Binding Address}" />
                                    <TextBlock Classes="muted" Text="{Binding AccountsText}" />
                                </StackPanel>
                            </Grid>
                        </controls:AngleCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
